# Copie ce fichier en .env et remplis avec les clés de ton projet Supabase
# (Supabase › Project Settings › API). La clé "publishable"/"anon" est publique,
# elle peut être dans l'app ; la sécurité vient des règles RLS de la base.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Abonnement Premium (RevenueCat › Project settings › API keys, clés publiques)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
