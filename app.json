{
  "expo": {
    "name": "WyytU",
    "slug": "WyytU",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wyytu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wyytu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "WyytU utilise la caméra pour ton selfie de vérification d’identité.",
        "NSPhotoLibraryUsageDescription": "WyytU accède à tes photos pour que tu choisisses celles de ton profil.",
        "NSLocationWhenInUseUsageDescription": "WyytU utilise ta position pour te montrer les sorties près de toi. Elle n’est jamais partagée avec les autres membres.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6A3D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.wyytu.app",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF6A3D"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "WyytU utilise la caméra pour ton selfie de vérification d’identité.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WyytU accède à tes photos pour que tu choisisses celles de ton profil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WyytU utilise ta position pour te montrer les sorties près de toi."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}